# Azure DevOps Configuration
# Copy this file to .env and fill in your values

# Required: Azure DevOps organization name
ORGANIZATION=your-org-name

# Required: Personal Access Token
# Create at: https://dev.azure.com/{organization}/_usersSettings/tokens
PERSONAL_ACCESS_TOKEN=your-pat-token

# Optional: Filter to specific projects (comma-separated)
# PROJECTS=project1,project2

# Optional: Start date for incremental replication (ISO 8601 format)
# START_DATE=2024-01-01T00:00:00Z
